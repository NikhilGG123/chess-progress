{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chess-progress",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",

  // Next.js needs Node's built-ins (crypto, buffer, streams) at runtime.
  // Without both of these the worker builds and then fails on the first
  // request, which is the worst way to find out.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },

  "observability": {
    "enabled": true,
  },
}
